{
  "name": "kurt-transport-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && vite build --ssr src/seo/meta.ts --outDir dist-ssr --emptyOutDir false && node scripts/prerender.mjs",
